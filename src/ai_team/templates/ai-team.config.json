{
  "requireCleanWorkingTree": true,
  "createBranchForEachRun": true,
  "reuseBranchForFollowUp": false,
  "branchPrefix": "ai/",
  "language": "en",
  "primaryProvider": "agy",
  "models": {},
  "providerArgs": {},
  "roleProviders": {},
  "agentTimeoutSeconds": 3600,
  "runTimeoutSeconds": 14400,
  "maxReviewRounds": 2,
  "verification": {"commands": [], "noChecksReason": ""},
  "riskPaths": {"HIGH": [], "MEDIUM": []},
  "passthroughEnv": [],
  "protectedIgnoredPaths": [".env", ".env.*", "*.pem", "*.key"],
  "antigravity": {
    "triageEffort": "low",
    "implementationEffort": "high",
    "verificationEffort": "medium",
    "sandbox": true,
    "fullAuto": false,
    "printTimeout": "60m"
  },
  "reviewPolicy": {
    "LOW": ["codex"],
    "MEDIUM": ["codex"],
    "HIGH": ["claude", "codex"]
  },
  "skipFinalVerificationAtLow": true,
  "allowUnreviewedLowRisk": false
}
